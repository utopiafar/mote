# Mote 中央节点：直接 npm start 的配置示例。
# 隔离部署先执行 node scripts/mote.mjs init --profile dev，并编辑生成的 mote.env。
# 完整默认值、范围、存储映射与重启流程：docs/server-configuration.md
# MOTE_ENV_FILE=/absolute/path/mote.env 仅加载选定文件；相对路径以文件所在目录为基准。

# [网络与访问] Docker 监听 0.0.0.0:47832，宿主端口默认只发布 loopback。
MOTE_HOST=127.0.0.1
MOTE_PORT=47832
# 客户端公开 HTTPS 基址。仅声明地址，不创建 DNS、Tunnel 或证书。
MOTE_PUBLIC_URL=
# 留空由首次启动生成 data/access-token；远程部署使用 openssl rand -hex 32 的随机值。
MOTE_TOKEN=
# 仅浏览器跨域需要。同域管理界面无需追加 origin，逗号分隔。
MOTE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# [存储] 原生：相对此文件。Docker 固定 /data，使用 profile 的命名卷。
# SQLite 原文和索引位于 mote.sqlite；图片位于 blobs/。修改路径不会搬迁现有资料。
MOTE_DATA_DIR=./data
# 可选图片 AES-256-GCM：64 位十六进制。SQLite 需主机加密卷。密钥须单独备份，勿在已有仓库更换。
MOTE_DATA_KEY=
# 逻辑入库预算 MiB（1–1000000），不是磁盘配额；日志、索引及备份额外占空间。
MOTE_MAX_STORAGE_MB=10240
# HTTP 导入/导出预算 MiB（1–256）；更大仓库使用离线备份。
MOTE_MAX_EXPORT_MB=64
# 0 关闭自动过期清理；非零显式删除早于该天数的资料（0–36500）。
MOTE_RETENTION_DAYS=0

# [中央 Agent] 未配置模型时，采集/归档可用，AI 功能显示未配置。
MOTE_MODEL=
MOTE_MODEL_BASE_URL=https://api.deepseek.com
MOTE_MODEL_API_KEY=
MOTE_MODEL_ALLOW_UNAUTHENTICATED_LOCAL=0
# off | low | high | max；模型服务需支持相应选项。
MOTE_MODEL_REASONING_EFFORT=high
# 单次输出预算，整数 256–32768。
MOTE_MODEL_MAX_TOKENS=8192
# Agent query/insight/memory deadline, integer milliseconds 5000..600000.
# Browser model requests allow an extra 60000ms; an upstream proxy may time out earlier.
MOTE_MODEL_TIMEOUT_MS=120000
# 定时回顾间隔小时（0–168），0 关闭；开启会产生模型调用。
MOTE_INSIGHT_INTERVAL_HOURS=0

# [可选向量索引] 配置后原文会发送到这个独立模型服务。
MOTE_EMBEDDING_MODEL=
MOTE_EMBEDDING_BASE_URL=
MOTE_EMBEDDING_API_KEY=

# [运行诊断] 固定事件、数量与耗时，不记录私密内容或凭据。修改后重启服务。
MOTE_DIAGNOSTICS_ENABLED=1
MOTE_DEBUG=0
MOTE_LOG_LEVEL=info
# 空值使用数据目录下 logs/；CLI 原生新环境为 ./logs；Docker 强制 /data/logs。
MOTE_LOG_DIR=
# 单文件 MiB（0.1–8）；总文件数（1–10）；内存事件数（100–5000）。
MOTE_LOG_MAX_MB=2
MOTE_LOG_MAX_FILES=3
MOTE_LOG_MAX_ENTRIES=2000

# [来源连接器] 默认关闭 MCP；Google 未配置 OAuth 客户端时不发起授权。
# 凭据默认存于 MOTE_DATA_DIR/connectors，不进入 HTTP 资料导出。
# 远程 Chatbot 可使用 HTTPS /mcp；独立随机 token，不复用中央所有者 token。
MOTE_MCP_ENABLED=0
MOTE_MCP_READ_TOKEN=
# 写回是独立能力，默认关闭；写 token 与读 token 必须不同。
MOTE_MCP_WRITE_ENABLED=0
MOTE_MCP_WRITE_TOKEN=
# 仅允许写回这些已注册来源，逗号分隔。开启写入时必须指定。
MOTE_MCP_WRITE_SOURCE_IDS=
# 仅开发时显式允许回环 MCP 服务；生产保持 0。
MOTE_MCP_ALLOW_LOCAL=0
# Google Cloud 中创建 Web OAuth 客户端，启用 Calendar API 并登记准确的回调地址。
MOTE_GOOGLE_CLIENT_ID=
MOTE_GOOGLE_CLIENT_SECRET=
# 例：https://context.example.com/oauth/google/callback；本机允许 http://127.0.0.1:端口/oauth/google/callback。
MOTE_GOOGLE_REDIRECT_URI=
# 自动拉取已授权来源的间隔，60–86400 秒；来源自身可以暂停。
MOTE_CONNECTOR_SYNC_INTERVAL_SECONDS=900
# Software update metadata. Checks never send archive content or node credentials.
MOTE_UPDATE_REPOSITORY=utopiafar/mote
MOTE_UPDATE_CHANNEL=stable
