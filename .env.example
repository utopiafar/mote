# First launch generates data/access-token if omitted. Keep this token private.
# Use `openssl rand -hex 32` for a remote deployment.
MOTE_TOKEN=
MOTE_HOST=127.0.0.1
MOTE_PORT=47832
MOTE_DATA_DIR=./data
# At rest: metadata SQLite needs encrypted host volume. Optional AES-256-GCM for image blobs.
# Generate with `openssl rand -hex 32`; keep this key with encrypted offline backups.
MOTE_DATA_KEY=
# Remote connections should terminate TLS at a reverse proxy. Set host to 0.0.0.0 in container only.
MOTE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Agent. No model configured = capture/archive works; AI explicitly unavailable.
MOTE_MODEL=
MOTE_MODEL_BASE_URL=https://api.deepseek.com
MOTE_MODEL_API_KEY=
MOTE_MODEL_ALLOW_UNAUTHENTICATED_LOCAL=0
# Optional independent embedding index. Text is sent only when explicitly configured.
MOTE_EMBEDDING_MODEL=
MOTE_EMBEDDING_BASE_URL=
MOTE_EMBEDDING_API_KEY=
# Retention disabled by default; nonzero value explicitly deletes records older than N days.
MOTE_RETENTION_DAYS=0
MOTE_MAX_STORAGE_MB=10240
MOTE_MAX_EXPORT_MB=64
# Optional scheduled Agent retrospectives; disabled when zero (hours).
MOTE_INSIGHT_INTERVAL_HOURS=0
