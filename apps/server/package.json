{
  "name": "@mote/server",
  "version": "0.0.38",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/check-dependencies.mjs && npm run build -w @mote/shared && npm run build -w @mote/agent",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && cp src/import-parser.mjs dist/import-parser.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@mote/agent": "0.1.0",
    "@mote/shared": "0.1.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "fflate": "^0.8.2",
    "google-auth-library": "11.0.2",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^5.4.149",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.4",
    "yaml": "^2.8.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.1",
    "@deepseek-ai/cordis": "4.0.2"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.0"
  }
}
