{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmitOnError": true,
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "src/plugin.mjs"
  ],
  "references": [
    {
      "path": "../shared"
    },
    {
      "path": "../plugin-api"
    },
    {
      "path": "../plugin-host"
    }
  ]
}
