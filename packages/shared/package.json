{
  "name": "@mote/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js"
    },
    "./connection": {
      "types": "./dist/connection.d.ts",
      "import": "./dist/connection.js",
      "require": "./dist/connection.js",
      "default": "./dist/connection.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js",
      "require": "./dist/metadata.js",
      "default": "./dist/metadata.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "import": "./dist/feedback.js",
      "require": "./dist/feedback.js",
      "default": "./dist/feedback.js"
    },
    "./release": {
      "types": "./dist/release.d.ts",
      "import": "./dist/release.js",
      "require": "./dist/release.js",
      "default": "./dist/release.js"
    },
    "./models": {
      "types": "./dist/model-providers.d.ts",
      "import": "./dist/model-providers.js",
      "require": "./dist/model-providers.js",
      "default": "./dist/model-providers.js"
    },
    "./capture-sessions": {
      "types": "./dist/capture-sessions.d.ts",
      "import": "./dist/capture-sessions.js",
      "require": "./dist/capture-sessions.js",
      "default": "./dist/capture-sessions.js"
    }
  },
  "typesVersions": {
    "*": {
      "feedback": [
        "dist/feedback.d.ts"
      ],
      "release": [
        "dist/release.d.ts"
      ],
      "connection": [
        "dist/connection.d.ts"
      ],
      "metadata": [
        "dist/metadata.d.ts"
      ],
      "models": [
        "dist/model-providers.d.ts"
      ],
      "capture-sessions": [
        "dist/capture-sessions.d.ts"
      ]
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
